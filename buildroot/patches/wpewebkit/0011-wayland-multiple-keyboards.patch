+static void wpeDisplayWaylandUpdateInputDevices(WPEDisplayWayland* display)
+{
+    auto* priv = display->priv;
+    unsigned devices = priv->wlSeat ? priv->wlSeat->availableInputDevices() : WPE_AVAILABLE_INPUT_DEVICE_NONE;
+    for (auto& entry : priv->keyboardSeats)
+        devices |= entry.second->availableInputDevices();
+    wpe_display_set_available_input_devices(WPE_DISPLAY(display), static_cast<WPEAvailableInputDevices>(devices));
+}
+
