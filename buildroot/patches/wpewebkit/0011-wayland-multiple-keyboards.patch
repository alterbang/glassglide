+void WaylandSeat::clearKeyboardFocus()
+{
+    if (m_keyboard.repeat.source)
+        g_source_set_ready_time(m_keyboard.repeat.source.get(), -1);
+
+    GRefPtr<WPEToplevelWayland> toplevel = m_keyboard.toplevel.get();
+    GRefPtr<WPEView> view;
+    bool stillFocused = false;
+    if (toplevel) {
+        view = wpeToplevelWaylandGetVisibleFocusedView(toplevel.get());
+        stillFocused = wpeToplevelWaylandSetIsFocused(toplevel.get(), false);
+    }
+
+    m_keyboard.toplevel = nullptr;
+    m_keyboard.repeat.key = 0;
+    m_keyboard.repeat.deadline = { };
+    m_keyboard.serial = 0;
+
+    if (view && !stillFocused)
+        wpe_view_focus_out(view.get());
+}
