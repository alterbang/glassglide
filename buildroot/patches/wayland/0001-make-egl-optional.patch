From: GlassGlide contributors
Subject: [PATCH] Allow a platform to provide its own Wayland EGL library

The webOS SDK supplies a platform-specific EGL wrapper. Allow the target
Wayland build to leave that wrapper in place, while keeping the default
unchanged for host tools.

--- a/meson.build
+++ b/meson.build
@@ -117,7 +117,9 @@ subdir('src')
 
 if get_option('libraries')
 	subdir('cursor')
-	subdir('egl')
+	if get_option('egl')
+		subdir('egl')
+	endif
 endif
 if get_option('tests')
 	subdir('tests')
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -2,6 +2,10 @@ option('libraries',
   description: 'Compile Wayland libraries',
   type: 'boolean',
   value: true)
+option('egl',
+  description: 'Compile the Wayland EGL wrapper',
+  type: 'boolean',
+  value: true)
 option('scanner',
   description: 'Compile wayland-scanner binary',
   type: 'boolean',
